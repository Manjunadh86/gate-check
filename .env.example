# ---- Sanity project (from sanity.io/manage) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-09-01

# Write token, project-level, Editor role. Used ONLY for server-side writes
# (check-run snapshots and proposed rulings). Context MCP is read-only.
SANITY_WRITE_TOKEN=

# ---- Sanity Context (organization level, NOT project level) ----
SANITY_ORGANIZATION_TOKEN=
# GROQ-mode endpoint: dataset source. Serves schema_explorer + groq_query.
SANITY_CONTEXT_GROQ_URL=
# Knowledge-Base-mode endpoint: knowledge-base source. Serves knowledge_base_read.
SANITY_CONTEXT_KB_URL=

# ---- Model ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
